- raw: "{\r\n    \"Key\": \"40651\",\r\n    \"Name\": \"主角\",\r\n    \"Desc\": \"山长，多日不见，您愈加健朗了，看这步履都比往日快了不少。\",\r\n    \"NameTw\": \"主角\",\r\n    \"DescTw\": \"山長，多日不見，您愈加健朗了，看這步履都比往日快了不少。\"\r\n  }"
  rawIndex: 40651

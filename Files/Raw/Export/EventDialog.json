- raw: "{\r\n    \"Key\": \"75595\",\r\n    \"Name\": \"主角\",\r\n    \"Desc\": \"那这九龙牌？\",\r\n    \"NameTw\": \"主角\",\r\n    \"DescTw\": \"那這九龍牌？\"\r\n  }"
  rawIndex: 75595

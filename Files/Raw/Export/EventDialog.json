- raw: "{\r\n    \"Key\": \"1000003\",\r\n    \"Name\": \"年轻士兵\",\r\n    \"Desc\": \"百户大人！西北方向有尘烟！\",\r\n    \"NameTw\": \"年輕士兵\",\r\n    \"DescTw\": \"百戶大人！西北方向有塵煙！\"\r\n  }"

- raw: "{\r\n    \"Key\": \"2407\",\r\n    \"Title\": \"五峰独秀\",\r\n    \"Name\": \"霍连云\",\r\n    \"Desc\": \"掌法融汇五峰意蕴，掌势犹如峰峦叠嶂，连绵不断，若非游遍五峰，身临其境，心有感悟，亦是难以得其精髓。\",\r\n    \"TitleTw\": \"五峰獨秀\",\r\n    \"NameTw\": \"霍連雲\",\r\n    \"DescTw\": \"掌法融匯五峰意蘊，掌勢猶如峰巒疊嶂，連綿不斷，若非遊遍五峰，身臨其境，心有感悟，亦是難以得其精髓。\"\r\n  }"
  rawIndex: 2407
  splits:
  - splitPath: Title
    text: "五峰独秀"
  - splitPath: Name
    text: "霍连云"
  - splitPath: Desc
    text: "掌法融汇五峰意蕴，掌势犹如峰峦叠嶂，连绵不断，若非游遍五峰，身临其境，心有感悟，亦是难以得其精髓。"
- raw: "{\r\n    \"Key\": \"2408\",\r\n    \"Title\": \"五峰独秀\",\r\n    \"Name\": \"霍连云\",\r\n    \"Desc\": \"现今你五峰遍览，想必心中已自有感悟，这门“五峰叠掌”今日我便代师传授与你。\",\r\n    \"TitleTw\": \"五峰獨秀\",\r\n    \"NameTw\": \"霍連雲\",\r\n    \"DescTw\": \"現今你五峰遍覽，想必心中已自有感悟，這門“五峰疊掌”今日我便代師傳授與你。\"\r\n  }"

- raw: "{\r\n    \"Key\": \"13003\",\r\n    \"Name\": \"百姓甲\",\r\n    \"Desc\": \"好像还收上品的蛇胆。\",\r\n    \"NameTw\": \"百姓甲\",\r\n    \"DescTw\": \"好像還收上品的蛇膽。\"\r\n  }"

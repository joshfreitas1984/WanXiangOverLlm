- raw: "{\r\n    \"Key\": \"2406\",\r\n    \"Title\": \"五峰独秀\",\r\n    \"Name\": \"霍连云\",\r\n    \"Desc\": \"本派前辈曾创出一门掌法，名为“五峰叠掌”。\",\r\n    \"TitleTw\": \"五峰獨秀\",\r\n    \"NameTw\": \"霍連雲\",\r\n    \"DescTw\": \"本派前輩曾創出一門掌法，名為“五峰疊掌”。\"\r\n  }"

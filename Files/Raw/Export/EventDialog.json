- raw: "{\r\n    \"Key\": \"40661\",\r\n    \"Title\": \"麓山居士\",\r\n    \"Name\": \"荀师道\",\r\n    \"Desc\": \"王羲之，生于东晋，字逸少，琅琊临沂人，居会稽山阴，官至右军将军，故而人称“王右军”。\",\r\n    \"TitleTw\": \"麓山居士\",\r\n    \"NameTw\": \"荀師道\",\r\n    \"DescTw\": \"王羲之，生於東晉，字逸少，琅琊臨沂人，居會稽山陰，官至右軍將軍，故而人稱“王右軍”。\"\r\n  }"
  rawIndex: 40661
  splits:
  - splitPath: Title
    text: "麓山居士"
  - splitPath: Name
    text: "荀师道"
  - splitPath: Desc
    text: "王羲之，生于东晋，字逸少，琅琊临沂人，居会稽山阴，官至右军将军，故而人称“王右军”。"
- raw: "{\r\n    \"Key\": \"40662\",\r\n    \"Title\": \"麓山居士\",\r\n    \"Name\": \"荀师道\",\r\n    \"Desc\": \"其七岁学书，先后从师于卫夫人和叔父王廙 ，此后博览秦汉篆隶精品，精研体势，心摹手追，广采众长，冶于一炉，创作出“天质自然，丰神盖代”的行书作品，被誉为“书圣”。\",\r\n    \"TitleTw\": \"麓山居士\",\r\n    \"NameTw\": \"荀師道\",\r\n    \"DescTw\": \"其七歲學書，先後從師於衛夫人和叔父王廙 ，此後博覽秦漢篆隸精品，精研體勢，心摹手追，廣採眾長，冶於一爐，創作出“天質自然，丰神蓋代”的行書作品，被譽為“書聖”。\"\r\n  }"
  rawIndex: 40662
  splits:
  - splitPath: Title
    text: "麓山居士"
  - splitPath: Name
    text: "荀师道"
  - splitPath: Desc
    text: "其七岁学书，先后从师于卫夫人和叔父王廙 ，此后博览秦汉篆隶精品，精研体势，心摹手追，广采众长，冶于一炉，创作出“天质自然，丰神盖代”的行书作品，被誉为“书圣”。"
- raw: "{\r\n    \"Key\": \"40663\",\r\n    \"Title\": \"麓山居士\",\r\n    \"Name\": \"荀师道\",\r\n    \"Desc\": \"现今传世之作以《黄庭经》、《乐毅论》、《快雪时晴帖》、《十七帖》、《初月帖》、《兰亭集序》等最为著名。\",\r\n    \"TitleTw\": \"麓山居士\",\r\n    \"NameTw\": \"荀師道\",\r\n    \"DescTw\": \"現今傳世之作以《黃庭經》、《樂毅論》、《快雪時晴帖》、《十七帖》、《初月帖》、《蘭亭集序》等最為著名。\"\r\n  }"

- raw: "{\r\n    \"Key\": \"3006\",\r\n    \"Title\": \"五峰独秀\",\r\n    \"Name\": \"霍连云\",\r\n    \"Desc\": \"入门三年弟子，皆需参与小校，通过演武对练检测各人的习武天赋资质。\",\r\n    \"TitleTw\": \"五峰獨秀\",\r\n    \"NameTw\": \"霍連雲\",\r\n    \"DescTw\": \"入門三年弟子，皆需參與小校，通過演武對練檢測各人的習武天賦資質。\"\r\n  }"

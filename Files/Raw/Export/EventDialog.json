- raw: "{\r\n    \"Key\": \"75328\",\r\n    \"Name\": \"主角\",\r\n    \"Desc\": \"店主，我听说湘西多山多匪，不知是真是假。\",\r\n    \"NameTw\": \"主角\",\r\n    \"DescTw\": \"店主，我聽說湘西多山多匪，不知是真是假。\"\r\n  }"
  rawIndex: 75328

- raw: "{\r\n    \"Key\": \"5902\",\r\n    \"Title\": \"三湘君子\",\r\n    \"Name\": \"长孙诚\",\r\n    \"Desc\": \"多谢宁王殿下厚赐，正所谓无功不受禄，如此厚赠，请恕在下实难消受。\",\r\n    \"TitleTw\": \"三湘君子\",\r\n    \"NameTw\": \"長孫誠\",\r\n    \"DescTw\": \"多謝寧王殿下厚賜，正所謂無功不受祿，如此厚贈，請恕在下實難消受。\"\r\n  }"
  rawIndex: 5902

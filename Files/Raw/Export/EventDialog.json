- raw: "{\r\n    \"Key\": \"76006\",\r\n    \"Name\": \"主角\",\r\n    \"Desc\": \"老人家，此不过是故典传说，无需为惧。\",\r\n    \"NameTw\": \"主角\",\r\n    \"DescTw\": \"老人家，此不過是故典傳說，無需為懼。\"\r\n  }"

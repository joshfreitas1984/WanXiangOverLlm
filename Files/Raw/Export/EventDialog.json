- raw: "{\r\n    \"Key\": \"40666\",\r\n    \"Title\": \"麓山居士\",\r\n    \"Name\": \"荀师道\",\r\n    \"Desc\": \"颜真卿，生于唐，字清臣，小名羡门子，别号应方，京兆万年人，唐代宗时官至吏部尚书、太子太师，封鲁郡公，故而人称“颜鲁公”。\",\r\n    \"TitleTw\": \"麓山居士\",\r\n    \"NameTw\": \"荀師道\",\r\n    \"DescTw\": \"顏真卿，生於唐，字清臣，小名羨門子，別號應方，京兆萬年人，唐代宗時官至吏部尚書、太子太師，封魯郡公，故而人稱“顏魯公”。\"\r\n  }"
  rawIndex: 40666
  splits:
  - splitPath: Title
    text: "麓山居士"
  - splitPath: Name
    text: "荀师道"
  - splitPath: Desc
    text: "颜真卿，生于唐，字清臣，小名羡门子，别号应方，京兆万年人，唐代宗时官至吏部尚书、太子太师，封鲁郡公，故而人称“颜鲁公”。"
- raw: "{\r\n    \"Key\": \"40667\",\r\n    \"Title\": \"麓山居士\",\r\n    \"Name\": \"荀师道\",\r\n    \"Desc\": \"其书法精妙，擅长行、楷，早年书法受外祖家殷氏、张旭影响，广汲蔡邕、王羲之、王献之、褚遂良等人之影响，融会贯通，形成其雄伟刚劲、大气磅礴的独特风格，人称“颜体”。\",\r\n    \"TitleTw\": \"麓山居士\",\r\n    \"NameTw\": \"荀師道\",\r\n    \"DescTw\": \"其書法精妙，擅長行、楷，早年書法受外祖家殷氏、張旭影響，廣汲蔡邕、王羲之、王獻之、褚遂良等人之影響，融會貫通，形成其雄偉剛勁、大氣磅礴的獨特風格，人稱“顏體”。\"\r\n  }"

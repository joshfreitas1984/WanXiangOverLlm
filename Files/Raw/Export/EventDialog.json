  - splitPath: Name
    text: "司徒伶"
  - splitPath: Desc
    text: "都喝不下，也算我输！"
- raw: "{\r\n    \"Key\": \"81117\",\r\n    \"Name\": \"酒客丙\",\r\n    \"Desc\": \"好，痛快，老李、老赵，还等什么，咱们喝！\",\r\n    \"NameTw\": \"酒客丙\",\r\n    \"DescTw\": \"好，痛快，老李、老趙，還等什麼，咱們喝！\"\r\n  }"
  rawIndex: 81117

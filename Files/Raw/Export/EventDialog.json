- raw: "{\r\n    \"Key\": \"42222\",\r\n    \"Name\": \"主角\",\r\n    \"Desc\": \"那便说定了，咱们来日天魔谷再会。\",\r\n    \"NameTw\": \"主角\",\r\n    \"DescTw\": \"那便說定了，咱們來日天魔谷再會。\"\r\n  }"

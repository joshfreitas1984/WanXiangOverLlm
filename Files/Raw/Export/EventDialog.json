- raw: "{\r\n    \"Key\": \"4206\",\r\n    \"Title\": \"白头翁\",\r\n    \"Name\": \"闻苍术\",\r\n    \"Desc\": \"附子，味辛温，主风寒咳逆邪气，温中，金创，破症坚积聚，血瘕，寒温，躄拘挛，脚痛，不能行步，生山谷。\",\r\n    \"TitleTw\": \"白頭翁\",\r\n    \"NameTw\": \"聞蒼朮\",\r\n    \"DescTw\": \"附子，味辛溫，主風寒咳逆邪氣，溫中，金創，破症堅積聚，血瘕，寒溫，躄拘攣，腳痛，不能行步，生山谷。\"\r\n  }"

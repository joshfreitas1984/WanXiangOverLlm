- raw: "{\r\n    \"Key\": \"83071\",\r\n    \"Name\": \"主角\",\r\n    \"Desc\": \"好，我晓得了，多谢阴兄。\",\r\n    \"NameTw\": \"主角\",\r\n    \"DescTw\": \"好，我曉得了，多謝陰兄。\"\r\n  }"
  rawIndex: 83071

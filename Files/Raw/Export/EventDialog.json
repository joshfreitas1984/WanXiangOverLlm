- raw: "{\r\n    \"Key\": \"4102\",\r\n    \"Name\": \"主角\",\r\n    \"Desc\": \"十二正经，与表里经脉相合，与相应脏腑络属。\",\r\n    \"NameTw\": \"主角\",\r\n    \"DescTw\": \"十二正經，與表裡經脈相合，與相應臟腑絡屬。\"\r\n  }"

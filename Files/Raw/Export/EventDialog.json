- raw: "{\r\n    \"Key\": \"52001\",\r\n    \"Name\": \"主角\",\r\n    \"Desc\": \"师伯，弟子近些日子在阁中转遍，觉得这一卷《无根树》颇合弟子缘法，斗胆向师伯求教。\",\r\n    \"NameTw\": \"主角\",\r\n    \"DescTw\": \"師伯，弟子近些日子在閣中轉遍，覺得這一卷《無根樹》頗合弟子緣法，斗膽向師伯求教。\"\r\n  }"
  rawIndex: 52001
